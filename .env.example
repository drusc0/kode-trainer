# Shared secret between the API and the code runner. Generate one with:  openssl rand -hex 32
RUNNER_TOKEN=change-me

# Optional: enables the chat assistant in the workspace. Bring your own key: Anthropic (sk-ant-...),
# OpenAI (sk-...), Gemini (AIza...) or OpenRouter (sk-or-...). The key's prefix picks the provider.
LLM_API_KEY=
# CHAT_MODEL=   # defaults per provider: claude-sonnet-5, gpt-5, gemini-2.5-flash, openai/gpt-5

# Hostnames the API answers to (comma-separated). Add yours if you serve KodeTrain under another name.
# ALLOWED_HOSTS=localhost,127.0.0.1
